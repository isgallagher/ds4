+/* A cancelled prefill is not a corrupt checkpoint.  The sync failed because the
+ * client went away, so the payload on disk is still byte-valid and is the
+ * cheapest recovery available to the next request -- which is often the resend
+ * that follows the very same interrupt.  Keep the payload, but run the session
+ * and schedule bookkeeping exactly as the failure path does today: the live
+ * session is mid-sync and must not be treated as a usable frontier.  Observed
+ * 2026-11-01 10:16: the file that had just served a 65,536-token hit was
+ * unlinked after a cancelled prefill, so the next request could only resume at
+ * 30,985 tokens and re-prefilled 112,866 (~5 min).  Every interrupt made the
+ * cache permanently worse, which is the escalation this function exists to stop. */
+static void kv_cache_keep_disk_entry(server *s, server_slot *slot,
+                                     const char *path, const char *reason) {
+    if (!s || !slot) return;
+    if (path)
+        server_log(DS4_LOG_KVCACHE,
+                   "ds4-server: kv cache entry kept reason=%s file=%s",
+                   reason, path);
+    slot->continued_last_store_tokens = 0;
+    if (slot->session) {
+        pthread_mutex_lock(&s->inference_mu);
+        ds4_session_invalidate(slot->session);
+        pthread_mutex_unlock(&s->inference_mu);
+    }
+}
