+/* Tokenize prompt_text[from, to) into `prompt`.  The window is copied because
+ * the tokenizer takes a NUL-terminated string. */
+static void kv_tokenize_window(ds4_engine *engine, const char *prompt_text,
+                               size_t from, size_t to, ds4_tokens *prompt) {
+    if (to <= from) return;
+    char *text = kv_xmalloc(to - from + 1);
+    memcpy(text, prompt_text + from, to - from);
+    text[to - from] = '\0';
+    ds4_tokenize_rendered_chat(engine, text, prompt);
+    free(text);
+}
+
+bool ds4_kvstore_build_prompt_with_vision_suffix(
+        ds4_engine *engine,
+        const ds4_tokens *exact_prefix,
+        const char *prompt_text,
+        size_t suffix_off,
+        ds4_kvstore_vision_tail *tail,
+        ds4_tokens *out) {
+    if (!prompt_text || !tail || !tail->images || tail->count < 0) return false;
+    const size_t total = strlen(prompt_text);
+    if (suffix_off > total) return false;
+
+    ds4_tokens prompt = {0};
+    ds4_tokens_copy(&prompt, exact_prefix);
+    size_t cursor = suffix_off;
+    bool ok = true;
+    for (int i = 0; i < tail->count; i++) {
+        ds4_kvstore_vision_tail_image *im = &tail->images[i];
+        im->in_tail = false;
+        im->ok = false;
+        im->new_start = 0;
+        /* Inside the payload: those rows are already in the session at the
+         * position the trailer identity was verified against. */
+        if (im->marker_off < suffix_off) continue;
+        if (im->marker_off < cursor || im->marker_bytes == 0 ||
+            im->marker_off + im->marker_bytes > total || !im->source)
+            { ok = false; break; }
+        /* Literal text must not impersonate an image: the key masked exactly
+         * this run to \036, so anything else means the offsets and the text
+         * disagree and the rebuild would splice rows into the wrong place. */
+        for (size_t b = 0; b < im->marker_bytes; b++) {
+            if (prompt_text[im->marker_off + b] != '\036') { ok = false; break; }
+        }
+        if (!ok) break;
+        kv_tokenize_window(engine, prompt_text, cursor, im->marker_off, &prompt);
+        const size_t bs = im->block_start;
+        const size_t rows = im->block_rows;
+        /* The span records the first pad, so the tail carries the full vision
+         * block: the token before it, the rows, and the closing token.  Same
+         * shape the live tier splices (build_live_prompt_suffix). */
+        if (bs < 1 || bs + rows >= (size_t)im->source->len) { ok = false; break; }
+        ds4_tokens_push(&prompt, im->source->v[bs - 1]);
+        im->new_start = (size_t)prompt.len;
+        for (size_t p = bs; p <= bs + rows; p++) ds4_tokens_push(&prompt, im->source->v[p]);
+        im->in_tail = true;
+        im->ok = true;
+        cursor = im->marker_off + im->marker_bytes;
+    }
+    if (ok) kv_tokenize_window(engine, prompt_text, cursor, total, &prompt);
+    if (!ok) {
+        for (int i = 0; i < tail->count; i++) {
+            tail->images[i].in_tail = false;
+            tail->images[i].ok = false;
+        }
+        ds4_tokens_free(&prompt);
+        return false;
+    }
+    ds4_tokens_free(out);
+    *out = prompt;
+    return true;
+}
