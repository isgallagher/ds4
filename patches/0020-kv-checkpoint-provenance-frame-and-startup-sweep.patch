+    size_t n = 0;
+    memcpy(buf + n, g_qwen4_rope_freq, sizeof(g_qwen4_rope_freq));
+    n += sizeof(g_qwen4_rope_freq);
+    float ms = g_qwen4_rope_mscale;
+    memcpy(buf + n, &ms, sizeof(ms)); n += sizeof(ms);
+    uint32_t nc = g_qwen4_native_ctx;
+    memcpy(buf + n, &nc, sizeof(nc)); n += sizeof(nc);
+    buf[n++] = g_qwen4_rope_yarn ? 1u : 0u;
+    return n;
