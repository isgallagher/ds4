+/* Prompt processing pre-empts generation, and a queued decode token never
+ * holds up a prefill.  One state, two predicates: the decode worker's gate and
+ * the prefill's, which is how the two can never disagree into a deadlock. */
+static void test_prefill_preempts_decode(void) {
+    server s = {0};
+    server_slot slots[2] = {0};
+    s.slots = slots;
+    s.slot_count = 2;
+    s.last_prefill_slot = 0;
+
+    /* Free executor, no prompt work queued: a decode batch may start. */
+    TEST_ASSERT(server_decode_step_allowed_locked(&s));
+
+    /* A queued decode token does not block prefill: prefill pre-empts it
+     * instead of waiting for it.  slot 1 is the waiting prefill — enter sets
+     * prefill_waiting before it waits on the executor. */
+    slots[1].decode_pending = true;
+    s.decode_pending = 1;
+    slots[1].prefill_waiting = true;
+    TEST_ASSERT(server_prefill_step_allowed_locked(&s, 1));
+    /* The same state is what the decode worker must not run through. */
+    TEST_ASSERT(!server_decode_step_allowed_locked(&s));
+
+    /* Round-robin still orders two prefills against each other: slot 0 ran
+     * last, so slot 1 is next and slot 0 waits. */
+    slots[0].prefill_waiting = true;
+    TEST_ASSERT(server_prefill_step_allowed_locked(&s, 1));
+    TEST_ASSERT(!server_prefill_step_allowed_locked(&s, 0));
+    slots[0].prefill_waiting = false;
+
+    /* A step already running keeps the executor to its end, and the queued
+     * prefill still holds priority over decode when that step finishes. */
+    s.model_busy = true;
+    TEST_ASSERT(!server_decode_step_allowed_locked(&s));
+    TEST_ASSERT(!server_prefill_step_allowed_locked(&s, 1));
+    s.model_busy = false;
+    TEST_ASSERT(!server_decode_step_allowed_locked(&s));
+    TEST_ASSERT(server_prefill_step_allowed_locked(&s, 1));
+
+    /* Only an empty prefill queue lets the decode worker through. */
+    slots[1].prefill_waiting = false;
+    TEST_ASSERT(server_decode_step_allowed_locked(&s));
+}
