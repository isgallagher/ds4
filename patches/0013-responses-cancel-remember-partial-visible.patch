     return true;
 }
 
+/* 0013: the mid-generation cancel branch, which is the branch an interrupted
+ * turn actually takes (the two above only fire once the decode loop has
+ * already finished).  It cannot reuse responses_cancel_release_live(): that
+ * helper delegates to the completed-turn builder, which closes the assistant
+ * surface with the model's end-of-turn marker, and a cancelled turn never
+ * commits that token -- the decode path above skips it under cancel.  A handle
+ * built that way would claim one token more than the live KV holds, so the next
+ * request would resume misaligned: wrong reuse, not the safe miss the tier
+ * contract demands.  So the surface remembered here stops short of every
+ * marker: the next request re-tokenizes the boundary and end-of-turn tokens
+ * onto the live KV, which is exactly the token the cancelled turn did not
+ * evaluate.
+ *
+ * Only a single-surface partial qualifies.  An open thinking block gives a
+ * reasoning-only partial; a no-reasoning answer gives a content-only partial.
+ * In both cases the remembered text is a byte prefix of the render the client
+ * sends next, so the visible tier matches at the live frontier and only the new
+ * tail tokenizes.  A partial that carries both reasoning and content needs the
+ * boundary marker between them to stay a prefix, and a partial that reached a
+ * tool call needs the call markup; neither is describable without appending a
+ * marker, so both keep the pre-fix clear.  That is the whole design: remember
+ * what is provably a prefix, clear everything else.
+ *
+ * The parser is asked without the closed-thinking requirement, because the
+ * cancelled turn is by definition unclosed.  Non-Responses cancels keep the
+ * full clear. */
+static bool responses_cancel_release_live_partial(server *s, server_slot *slot,
+                                                  const job *j,
+                                                  const char *generated,
+                                                  bool saw_tool_start) {
+    if (j->req.api != API_RESPONSES) {
+        request_live_state_clear(s, slot);
+        return false;
+    }
+
+    char *content = NULL;
+    char *reasoning = NULL;
+    tool_calls calls = {0};
+    bool recovered = false;
+    char parse_err[256] = {0};
+    const char *parse_finish = "stop";
+    const bool parsed = parse_generated_message_for_response_for_syntax(
+        j->req.model_syntax, generated ? generated : "", j->req.has_tools,
+        saw_tool_start, false, &parse_finish, parse_err, sizeof(parse_err),
+        &content, &reasoning, &calls, &recovered, &j->req.tool_orders);
+
+    bool remembered = false;
+    if (parsed && calls.len == 0 && !saw_tool_start) {
+        const bool has_reasoning = reasoning && reasoning[0];
+        const bool has_content = content && content[0];
+        if (has_reasoning != has_content) {
+            buf visible = {0}, suffix = {0};
+            buf_puts(&visible, j->req.prompt_text ? j->req.prompt_text : "");
+            append_trimmed_text(&suffix, has_reasoning ? reasoning : content);
+            buf_puts(&visible, suffix.ptr ? suffix.ptr : "");
+            buf_free(&suffix);
+            if (visible.ptr && visible.ptr[0]) {
+                responses_live_remember(s, slot, visible.ptr, NULL, NULL,
+                                        &j->req);
+                thinking_live_clear(s, slot);
+                anthropic_live_clear(s, slot);
+                remembered = true;
+            }
+            buf_free(&visible);
+        }
+    }
+    free(content);
+    free(reasoning);
+    tool_calls_free(&calls);
+    if (!remembered) request_live_state_clear(s, slot);
+    return remembered;
+}
