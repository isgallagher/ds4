+/* One image of the incoming request, described the way the loader needs it.
+ * A multimodal prompt carries each image as a short request-local marker, and
+ * the disk key is that text with every marker masked to \036, so marker_off
+ * is an offset in the *normalized* text the lookup used -- normalization
+ * preserves byte offsets, so the same offset is valid in the raw text too.
+ * An image whose marker sits before the cached prefix is already inside the
+ * payload and is left alone; one that sits after it must be spliced from the
+ * request's own prompt tokens, because tokenizing the marker text yields a
+ * few literal tokens instead of the placeholder rows the KV rows came from. */
+typedef struct {
+    size_t marker_off;
+    size_t marker_bytes;
+    const ds4_tokens *source;   /* the request's real prompt tokens */
+    size_t block_start;         /* index in source of the first placeholder row */
+    size_t block_rows;          /* placeholder row count */
+    /* Out. */
+    size_t new_start;           /* index in the rebuilt prompt of the first row */
+    bool in_tail;               /* the marker sat in the suffix and was spliced */
+    bool ok;                    /* the splice produced a block for this image */
+} ds4_kvstore_vision_tail_image;
+
+typedef struct {
+    ds4_kvstore_vision_tail_image *images;
+    int count;
+} ds4_kvstore_vision_tail;
