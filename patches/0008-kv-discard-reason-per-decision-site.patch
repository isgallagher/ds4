+/* Drop a disk payload this request could not use, with the live state loaded
+ * from it.  The reason names the decision site, because the sites mean
+ * different things to an operator: a forked payload is a deliberate policy
+ * discard of a checkpoint that is still valid for its own owner, a sync
+ * failure is an engine error, and a cancelled job is a client that stopped
+ * reading.  One label for all three made a cancelled turn read like cache
+ * corruption. */
+static void kv_cache_discard_disk_entry(server *s, server_slot *slot,
+                                        const char *path,
+                                        const char *reason) {
     if (!s || !slot || !path) return;
     pthread_mutex_lock(&s->kv_mu);
     if (unlink(path) == 0) {
         server_log(DS4_LOG_KVCACHE,
-                   "ds4-server: kv cache discarded reason=prefill-failed file=%s",
-                   path);
+                   "ds4-server: kv cache discarded reason=%s file=%s",
+                   reason, path);
     } else if (errno != ENOENT) {
         server_log(DS4_LOG_WARNING,
-                   "ds4-server: kv cache failed to discard prefill-failed file=%s: %s",
-                   path, strerror(errno));
+                   "ds4-server: kv cache failed to discard entry (%s) file=%s: %s",
+                   reason, path, strerror(errno));
     }
     pthread_mutex_unlock(&s->kv_mu);
     slot->continued_last_store_tokens = 0;
