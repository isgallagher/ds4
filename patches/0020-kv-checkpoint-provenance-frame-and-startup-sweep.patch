+/* Strict startup sweep: a checkpoint whose envelope does not carry this build's
+ * format version, or whose provenance frame is not this server's, can never be
+ * restored here -- and while it sits in the directory it consumes real disk that
+ * the store cannot see, because every budget and eviction sum walks the indexed
+ * entries and a header that fails to read keeps a file out of the index entirely
+ * (kv_cache_refresh pushes only on success).  Owner ruling 2026-11-26: delete on
+ * ANY mismatch, newer or older, and sweep at startup only.  Startup only is not
+ * caution but correctness: a file being written has no valid header until its
+ * write completes, so sweeping during serving would unlink a live write out from
+ * under its own writer.  The frame digest carries the rope frame, the model, the
+ * routed-expert quantization and the context, so one comparison enforces all
+ * four.  Returns files removed. */
+static int kv_cache_sweep_version(ds4_kvstore *kc, uint64_t *freed) {
+    DIR *d = opendir(kc->dir);
+    if (!d) return 0;
+    int removed = 0, kept = 0, would = 0, n_short = 0, n_magic = 0, n_version = 0, n_abi = 0, n_frame = 0;
+    struct dirent *de;
+    uint8_t h[DS4_KVSTORE_FIXED_HEADER];
+    while ((de = readdir(d)) != NULL) {
+        char sha[41];
+        if (!ds4_kvstore_sha_hex_name(de->d_name, sha)) continue;
+        char *path = ds4_kvstore_path_join(kc->dir, de->d_name);
+        struct stat st;
+        if (lstat(path, &st) != 0 || !S_ISREG(st.st_mode)) { free(path); continue; }
+        size_t got = 0;
+        FILE *fp = fopen(path, "rb");
+        if (fp) { got = fread(h, 1, sizeof(h), fp); fclose(fp); }
+        const char *why = NULL;
+        if (got < sizeof(h)) { why = "unreadable"; n_short++; }
+        else if (h[0] != KV_CACHE_MAGIC0 || h[1] != KV_CACHE_MAGIC1 ||
+                 h[2] != KV_CACHE_MAGIC2) { why = "bad-magic"; n_magic++; }
+        else if (h[3] != (uint8_t)KV_CACHE_VERSION) { why = "version"; n_version++; }
+        else if (h[20] != (uint8_t)KV_CACHE_PAYLOAD_ABI) { why = "payload-abi"; n_abi++; }
+        else if (((uint32_t)h[21] | ((uint32_t)h[22] << 8) | ((uint32_t)h[23] << 16)) !=
+                 (kc->frame_id & 0xffffffu)) { why = "frame"; n_frame++; }
+        if (!why) { kept++; free(path); continue; }
+        if (!kc->sweep_enforce) {
+            would++;
+            *freed += (uint64_t)st.st_size;
+            kv_logf(kc, DS4_KVSTORE_LOG_KVCACHE,
+                    "%s: kv cache sweep would remove reason=%s file=%s size=%.2f MiB",
+                    kv_log_name(kc), why, path, (double)st.st_size / (1024.0 * 1024.0));
+            free(path); continue;
+        }
+        if (unlink(path) == 0) {
+            removed++;
+            *freed += (uint64_t)st.st_size;
+            kv_logf(kc, DS4_KVSTORE_LOG_KVCACHE,
+                    "%s: kv cache sweep removed reason=%s file=%s size=%.2f MiB",
+                    kv_log_name(kc), why, path, (double)st.st_size / (1024.0 * 1024.0));
+        } else {
+            kv_logf(kc, DS4_KVSTORE_LOG_KVCACHE,
+                    "%s: kv cache sweep FAILED to remove reason=%s file=%s: %s",
