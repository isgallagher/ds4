+/* The checkpoint trailer is the only place a vision payload can name the
+ * pixels its KV rows came from, so every rule that keeps a wrong-attention
+ * load from happening lives in this section's framing.  These cases are the
+ * gate: a match, four ways a mismatch must refuse, the fail-closed bit, and
+ * the two shapes an old checkpoint has no way to produce. */
+static void test_vision_identity_trailer(void) {
+    const int ids[4] = { 1, 2, 3, 4 };
+    ds4_vision_span spans[2];
+    memset(spans, 0, sizeof(spans));
+    spans[0].token_start = 1000;
+    spans[0].embedding.token_count = 64;
+    spans[0].embedding.fingerprint[0] = 7;
+    spans[1].token_start = 2000;
+    spans[1].embedding.token_count = 96;
+    spans[1].embedding.fingerprint[0] = 8;
+    ds4_session *sess = ds4_session_new_test_checkpoint(ids, 4);
+    TEST_ASSERT(sess != NULL);
+    ds4_session_set_test_images(sess, spans, 2);
+
+    size_t count = 0, covered = 0;
+    /* A frontier inside an image names rows the identity cannot call covered,
+     * so the store must not happen at all. */
+    TEST_ASSERT(!kv_vision_identity_prepare(sess, 2032, &count, &covered));
+    TEST_ASSERT(!kv_vision_identity_prepare(sess, 1024, &count, &covered));
+    TEST_ASSERT(kv_vision_identity_prepare(sess, 2096, &count, &covered));
+    TEST_ASSERT(count == 2 && covered == 2);
+    /* A frontier before every image stores cleanly and covers nothing. */
+    TEST_ASSERT(kv_vision_identity_prepare(sess, 500, &count, &covered));
+    TEST_ASSERT(count == 2 && covered == 0);
+
+    FILE *fp = tmpfile();
+    TEST_ASSERT(fp != NULL);
+    kv_store_ctx ctx = { .session = sess, .vision = true,
+                         .store_len = 2096, .image_count = 2, .covered = 2 };
+    uint64_t written = 0;
+    TEST_ASSERT(kv_vision_section_write(&ctx, fp, &written));
+    TEST_ASSERT(written == KV_VISION_SECTION_HEADER + 2u * KV_VISION_RECORD +
+                           KV_VISION_FOOTER);
+    /* The tool map keeps the first position, so the section cannot start
+     * before the caller's own bytes. */
+    const uint64_t trailer_start = 0;
+    long size = 0;
+    TEST_ASSERT(fseeko(fp, 0, SEEK_END) == 0);
+    size = ftell(fp);
+    TEST_ASSERT((uint64_t)size == trailer_start + written);
+    /* The footer is the last thing in the file, and it is what a reader finds
+     * without knowing the tool map's length. */
+    uint8_t foot[KV_VISION_FOOTER];
+    TEST_ASSERT(fseeko(fp, (off_t)(size - (long)KV_VISION_FOOTER), SEEK_SET) == 0);
+    TEST_ASSERT(fread(foot, 1, sizeof(foot), fp) == sizeof(foot));
+    TEST_ASSERT(foot[0] == KV_VISION_FOOTER_MAGIC0 &&
+                foot[12] == KV_VISION_SECTION_MAGIC0);
+
+    size_t got = 99;
+    kv_vision_verify want = { .images = spans, .image_count = 2,
+                              .covered_out = &got };
+    TEST_ASSERT(kv_vision_section_verify(fp, trailer_start, (uint64_t)size,
+                                        &want));
+    TEST_ASSERT(got == 2);
+    /* A frontier that leaves an image uncovered must never be loaded: the
+     * rebuilt tail would tokenize that image's marker text instead of its
+     * placeholder rows. */
+    ctx.covered = 1;
+    uint64_t partial_bytes = 0;
+    FILE *fp_partial = tmpfile();
+    TEST_ASSERT(fp_partial != NULL);
+    TEST_ASSERT(kv_vision_section_write(&ctx, fp_partial, &partial_bytes));
+    TEST_ASSERT(fseeko(fp_partial, 0, SEEK_END) == 0);
+    got = 99;
+    TEST_ASSERT(!kv_vision_section_verify(fp_partial, 0,
+                                         (uint64_t)ftell(fp_partial), &want));
+    ctx.covered = 2;
+    fclose(fp_partial);
+
+    /* One changed pixel: same text, same positions, different picture. */
+    ds4_vision_span other[2];
+    memcpy(other, spans, sizeof(other));
+    other[1].embedding.fingerprint[0] = 9;
+    got = 99;
+    want.images = other;
+    TEST_ASSERT(!kv_vision_section_verify(fp, trailer_start, (uint64_t)size,
+                                         &want));
+    /* Same pixels, different row count: the spans no longer describe the KV. */
+    memcpy(other, spans, sizeof(other));
+    other[0].embedding.token_count = 65;
+    TEST_ASSERT(!kv_vision_section_verify(fp, trailer_start, (uint64_t)size,
+                                         &want));
+    /* Same pixels, shifted position: the disk tier does not rebase. */
+    memcpy(other, spans, sizeof(other));
+    other[1].token_start = 2001;
+    TEST_ASSERT(!kv_vision_section_verify(fp, trailer_start, (uint64_t)size,
+                                         &want));
+    /* One image appended: the frontier's coverage is not what was stored. */
+    ds4_vision_span three[3];
+    memcpy(three, spans, sizeof(spans));
+    three[2].token_start = 3000;
+    three[2].embedding.token_count = 32;
+    three[2].embedding.fingerprint[0] = 9;
+    want.images = three;
+    want.image_count = 3;
+    TEST_ASSERT(!kv_vision_section_verify(fp, trailer_start, (uint64_t)size,
+                                         &want));
+    want.images = spans;
+    want.image_count = 2;
+    want.covered_out = NULL;
+    TEST_ASSERT(kv_vision_section_verify(fp, trailer_start, (uint64_t)size,
+                                        &want));
+    fclose(fp);
+
+    /* A file with no section at all: the shape every checkpoint written before
+     * this patch has, and the shape a text checkpoint keeps.  Text loads,
+     * images do not, and that is decided by the header bit alone. */
+    fp = tmpfile();
+    TEST_ASSERT(fp != NULL);
+    ctx.vision = false;
+    written = 0;
+    TEST_ASSERT(kv_vision_section_write(&ctx, fp, &written) && written == 0);
+    TEST_ASSERT(fseeko(fp, 0, SEEK_END) == 0 && ftell(fp) == 0);
+    ds4_kvstore_entry hdr;
+    memset(&hdr, 0, sizeof(hdr));
+    want.images = NULL;
+    want.image_count = 0;
+    TEST_ASSERT(kv_cache_vision_verify_cb(NULL, fp, &hdr, 0, &want));
+    want.image_count = 2;
+    want.images = spans;
+    TEST_ASSERT(!kv_cache_vision_verify_cb(NULL, fp, &hdr, 0, &want));
+    /* Truncated garbage is not a footer, and a bit that promises an identity
+     * the file cannot produce is a reject for every request, text included. */
+    uint8_t junk[64] = { 0 };
+    TEST_ASSERT(fwrite(junk, 1, sizeof(junk), fp) == sizeof(junk));
+    TEST_ASSERT(fseeko(fp, 0, SEEK_END) == 0);
+    want.image_count = 0;
+    want.images = NULL;
+    TEST_ASSERT(kv_cache_vision_verify_cb(NULL, fp, &hdr, 0, &want));
+    hdr.ext_flags = DS4_KVSTORE_EXT_VISION_IDENTITY;
+    TEST_ASSERT(!kv_cache_vision_verify_cb(NULL, fp, &hdr, 0, &want));
+    /* A real framed checkpoint: header, cached text, payload, then the
+     * section.  This is the one shape that may serve a multimodal request, and
+     * the trailer starts where the fixed header says it must. */
+    fp = tmpfile();
+    TEST_ASSERT(fp != NULL);
+    TEST_ASSERT(fwrite(junk, 1, sizeof(junk), fp) == sizeof(junk));
+    ctx.vision = true;
+    ctx.image_count = 2;
+    ctx.covered = 2;
+    TEST_ASSERT(kv_vision_section_write(&ctx, fp, &written));
+    memset(&hdr, 0, sizeof(hdr));
+    hdr.ext_flags = DS4_KVSTORE_EXT_VISION_IDENTITY;
+    hdr.payload_bytes = 0;
+    const uint64_t fake_map = (uint64_t)sizeof(junk);
+    /* The 64 bytes above stand in for a tool map whose length a reader cannot
+     * know: the footer locates the section by its own size, which is why the
+     * section is found at all without consulting the map. */
+    TEST_ASSERT((uint64_t)ftell(fp) == fake_map + written);
+    want.images = spans;
+    want.image_count = 2;
+    got = 99;
+    want.covered_out = &got;
+    TEST_ASSERT(kv_cache_vision_verify_cb(NULL, fp, &hdr, 0, &want));
+    TEST_ASSERT(got == 2);
+    /* The hook restores the position the payload loader continues from. */
+    TEST_ASSERT(ftell(fp) == (long)(fake_map + written));
+    other[0].embedding.fingerprint[0] = 42;
+    want.images = other;
+    TEST_ASSERT(!kv_cache_vision_verify_cb(NULL, fp, &hdr, 0, &want));
+    fclose(fp);
+
+    /* Fail closed on a file that cannot hold a footer at all. */
+    ds4_kvstore_entry hdr2;
+    memset(&hdr2, 0, sizeof(hdr2));
+    fp = tmpfile();
+    TEST_ASSERT(fp != NULL);
+    hdr2.ext_flags = DS4_KVSTORE_EXT_VISION_IDENTITY;
+    hdr2.payload_bytes = 0;
+    want.images = NULL;
+    want.image_count = 0;
+    want.covered_out = NULL;
+    TEST_ASSERT(!kv_cache_vision_verify_cb(NULL, fp, &hdr2, 0, &want));
+    hdr2.ext_flags = 0;
+    TEST_ASSERT(kv_cache_vision_verify_cb(NULL, fp, &hdr2, 0, &want));
+    /* The verify hook must leave the position where the payload loader finds
+     * it, because that loader continues from the current offset. */
+    uint8_t payload[4] = { 0xAA, 0xBB, 0xCC, 0xDD };
+    TEST_ASSERT(fwrite(payload, 1, sizeof(payload), fp) == sizeof(payload));
+    TEST_ASSERT(fflush(fp) == 0);
+    TEST_ASSERT(fseeko(fp, 2, SEEK_SET) == 0);
+    hdr2.ext_flags = DS4_KVSTORE_EXT_VISION_IDENTITY;
+    TEST_ASSERT(!kv_cache_vision_verify_cb(NULL, fp, &hdr2, 0, &want));
+    TEST_ASSERT(ftell(fp) == 2);
+    fclose(fp);
