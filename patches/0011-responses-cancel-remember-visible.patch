+/* 0011 cancel shape: a Responses cancel remembers the visible handle at the
+ * live frontier instead of clearing it; a non-Responses cancel keeps the
+ * full clear. The shape escape-and-continue depends on is
+ * responses_live.live_tokens == ds4_session_pos(). */
+static void test_responses_cancel_release_live(void) {
+    server s = {0};
+    server_slot slot = {0};
+    int ckpt_tok[10];
+    for (int i = 0; i < 10; i++) ckpt_tok[i] = i + 1;
+    slot.session = ds4_session_new_test_checkpoint(ckpt_tok, 10);
+    job j = {0};
+    j.req.api = API_RESPONSES;
+    j.req.prompt_text = xstrdup("conv prompt ");
+    ds4_tokens_push(&j.req.prompt, 999);
+    TEST_ASSERT(responses_cancel_release_live(&s, &slot, &j, "",
+                                              "partial thinking", NULL));
+    TEST_ASSERT(slot.responses_live.valid);
+    TEST_ASSERT(slot.responses_live.live_tokens == 10);
+    TEST_ASSERT(slot.responses_live.visible_len > 12);
+    TEST_ASSERT(!memcmp(slot.responses_live.visible_text, "conv prompt ", 12));
+    /* A non-Responses cancel on the same slot clears everything. */
+    slot.thinking_live.valid = true;
+    j.req.api = API_OPENAI;
+    TEST_ASSERT(!responses_cancel_release_live(&s, &slot, &j, "", NULL, NULL));
+    TEST_ASSERT(!slot.responses_live.valid);
+    TEST_ASSERT(!slot.thinking_live.valid);
+    live_tool_state_free(&slot.responses_live);
+    visible_live_free(&slot.thinking_live);
+    ds4_session_free_test_checkpoint(slot.session);
+    request_free(&j.req);
 }
 
