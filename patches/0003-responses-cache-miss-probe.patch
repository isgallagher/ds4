+            const ds4_tokens *prompt_toks = &j->req.prompt;
+            const int live_len = live_toks ? live_toks->len : 0;
+            const int prompt_len = prompt_toks ? prompt_toks->len : 0;
+            const int w = 32;
+            int s0 = common - w;
+            if (s0 < 0) s0 = 0;
