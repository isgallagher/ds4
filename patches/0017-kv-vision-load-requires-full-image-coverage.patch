diff --git a/ds4_server.c b/ds4_server.c
index 00e3656..62f5176 100644
--- a/ds4_server.c
+++ b/ds4_server.c
@@ -11759,6 +11759,18 @@ static bool kv_vision_section_verify(FILE *fp, uint64_t trailer_start,
             KV_VISION_FOOTER != (uint64_t)total)
         return false;
     if (count != want->image_count || covered > count) return false;
+    /* The frontier must cover EVERY image the request names.  The disk tier
+     * rebuilds the tail by tokenizing the text after the cached prefix, and
+     * image markers in that tail tokenize to a handful of tokens instead of
+     * the thousand placeholder rows the prompt really holds -- the effective
+     * prompt comes out short and the sync fails with "image span does not
+     * cover image placeholder tokens".  Measured 2026-11-14 19:28:13: a hit at
+     * 32,768 built ctx=32768..292451 for a 307,893-token prompt, the client got
+     * a 500, and the payload was discarded.  Serving a request that appends an
+     * image needs the live tier's splice helper in this path, which is stage 2;
+     * until then an uncovered image is a miss, which is the slow turn, not a
+     * broken one. */
+    if (covered != count) return false;
     for (uint32_t i = 0; i < count; i++) {
         uint8_t rec[KV_VISION_RECORD];
         if (fread(rec, 1, sizeof(rec), fp) != sizeof(rec)) return false;
@@ -14016,7 +14028,7 @@ static void canonicalize_tool_checkpoint(server *s, server_slot *slot,
         ds4_tokens effective = {0};
         int loaded = kv_cache_try_load_text(s, slot,
                                             rendered.ptr ? rendered.ptr : "",
-                                            NULL, 0,
+                                            j->req.images, j->req.image_count,
                                             &effective, &path, NULL, false);
         if (loaded == 0) {
             pthread_mutex_lock(&s->inference_mu);
@@ -25814,6 +25826,20 @@ static void test_vision_identity_trailer(void) {
     TEST_ASSERT(kv_vision_section_verify(fp, trailer_start, (uint64_t)size,
                                         &want));
     TEST_ASSERT(got == 2);
+    /* A frontier that leaves an image uncovered must never be loaded: the
+     * rebuilt tail would tokenize that image's marker text instead of its
+     * placeholder rows. */
+    ctx.covered = 1;
+    uint64_t partial_bytes = 0;
+    FILE *fp_partial = tmpfile();
+    TEST_ASSERT(fp_partial != NULL);
+    TEST_ASSERT(kv_vision_section_write(&ctx, fp_partial, &partial_bytes));
+    TEST_ASSERT(fseeko(fp_partial, 0, SEEK_END) == 0);
+    got = 99;
+    TEST_ASSERT(!kv_vision_section_verify(fp_partial, 0,
+                                         (uint64_t)ftell(fp_partial), &want));
+    ctx.covered = 2;
+    fclose(fp_partial);
 
     /* One changed pixel: same text, same positions, different picture. */
     ds4_vision_span other[2];
