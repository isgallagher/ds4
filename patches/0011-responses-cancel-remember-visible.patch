+/* An interrupted Responses turn still leaves a usable live frontier: the KV
+ * holds the sampled tokens, and a client that continues the conversation
+ * re-renders the partial turn in its next request.  The pre-fix cancel path
+ * cleared every live handle, so that next request reused nothing: routing
+ * found no slot worth keeping, evicted a resident checkpoint, and the whole
+ * prompt re-prefilled from token zero (observed 2026-10-31 19:48: 201,688
+ * tokens, 229 s, for a conversation 31 tokens from its frontier).  Remember
+ * the visible surface at the CURRENT frontier instead, exactly as the
+ * completed-turn path builds it: the visible tier's strict live_tokens
+ * equality then holds, the next request continues from live KV, and only
+ * the new tail tokenizes.  If the client replays bytes the server never
+ * streamed, or drops the aborted turn, the byte-prefix check fails and the
+ * request misses exactly as before the fix - a safe miss, never a wrong
+ * reuse.  Non-Responses cancels keep the full clear.  Returns true when the
+ * Responses visible state was remembered (for the cancel log line). */
+static bool responses_cancel_release_live(server *s, server_slot *slot,
+                                          const job *j,
+                                          const char *content,
+                                          const char *reasoning,
+                                          const tool_calls *calls) {
+    if (j->req.api != API_RESPONSES) {
+        request_live_state_clear(s, slot);
+        return false;
+    }
+    responses_live_remember_turn(s, slot, &j->req,
+                                 content ? content : "", reasoning, calls);
+    thinking_live_clear(s, slot);
+    anthropic_live_clear(s, slot);
+    return true;
+}
