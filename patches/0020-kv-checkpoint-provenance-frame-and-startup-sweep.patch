+/* The frame id is the low 24 bits of the digest, because that is all the header
+ * has room for (bytes 21-23).  16.7 million values is far past the number of
+ * distinct profiles one box runs, and the id never has to be unique across
+ * machines -- it only has to disagree when the rows disagree. */
+uint32_t ds4_kvstore_frame_id(const void *bytes, size_t len) {
