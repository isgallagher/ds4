+/* A replayed final answer carries its reasoning (pi 1.0.4), so the recorded
+ * Responses-visible suffix for a no-tool-call Qwen turn must include it.  The
+ * expectation is built from the Qwen suffix builder itself, never from
+ * template literals. */
+static void test_qwen_visible_suffix_carries_final_answer_reasoning(void) {
+    request r;
+    request_init(&r, REQ_CHAT, 128);
+    r.api = API_RESPONSES;
+    r.model_syntax = SERVER_MODEL_SYNTAX_QWEN;
+    r.think_mode = DS4_THINK_HIGH;
+    r.reasoning_summary_emit = true;
+
+    char *suffix = build_responses_visible_assistant_suffix(&r, "5",
+                                                            "hidden summary",
+                                                            NULL);
+    char *want = build_qwen_assistant_suffix(&r, "5", "hidden summary",
+                                             true, NULL);
+    TEST_ASSERT(suffix && want && strcmp(suffix, want) == 0);
+    TEST_ASSERT(suffix && strstr(suffix, "hidden summary") != NULL);
+
+    /* The tier's real condition: the recorded suffix is a byte substring of
+     * the render the next request produces for the replayed turn. */
+    chat_msg am = {0};
+    am.role = xstrdup("assistant");
+    am.content = xstrdup("5");
+    am.reasoning = xstrdup("hidden summary");
+    buf rendered = {0};
+    append_qwen_assistant_message(&rendered, &am, NULL);
+    TEST_ASSERT(rendered.ptr && suffix &&
+                strstr(rendered.ptr, suffix) != NULL);
+
+    buf_free(&rendered);
+    free(am.role);
+    free(am.content);
+    free(am.reasoning);
+    free(suffix);
+    free(want);
+    request_free(&r);
+}
+
