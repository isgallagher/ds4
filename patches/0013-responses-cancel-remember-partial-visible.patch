@@ -17948,6 +18026,52 @@ static void test_responses_cancel_release_live(void) {
     request_free(&j.req);
 }
 
+/* 0013 mid-generation cancel shape: an unclosed thinking partial is remembered
+ * as prompt text + reasoning and nothing else, because the cancelled turn never
+ * committed the end-of-turn token.  A cancel that produced nothing keeps the
+ * full clear, and so does a non-Responses cancel. */
+static void test_responses_cancel_release_live_partial(void) {
+    server s = {0};
+    server_slot slot = {0};
+    int ckpt_tok[10];
+    for (int i = 0; i < 10; i++) ckpt_tok[i] = i + 1;
+    slot.session = ds4_session_new_test_checkpoint(ckpt_tok, 10);
+    job j = {0};
+    j.req.api = API_RESPONSES;
+    j.req.model_syntax = SERVER_MODEL_SYNTAX_QWEN;
+    j.req.think_mode = DS4_THINK_HIGH;
+    j.req.prompt_text = xstrdup("conv prompt ");
+    ds4_tokens_push(&j.req.prompt, 999);
+
+    /* Open thinking, no message text: remembered, and the surface ends exactly
+     * where the reasoning ends -- no marker bytes appended. */
+    TEST_ASSERT(responses_cancel_release_live_partial(&s, &slot, &j,
+                                                     "partial thinking", false));
+    TEST_ASSERT(slot.responses_live.valid);
+    TEST_ASSERT(slot.responses_live.live_tokens == 10);
+    TEST_ASSERT(!memcmp(slot.responses_live.visible_text, "conv prompt ", 12));
+    TEST_ASSERT(slot.responses_live.visible_len ==
+                12 + strlen("partial thinking"));
+    live_tool_state_free(&slot.responses_live);
+
+    /* Nothing generated yet: nothing is a prefix, so the clear stands. */
+    slot.thinking_live.valid = true;
+    TEST_ASSERT(!responses_cancel_release_live_partial(&s, &slot, &j, "", false));
+    TEST_ASSERT(!slot.responses_live.valid);
+    TEST_ASSERT(!slot.thinking_live.valid);
+
+    /* A non-Responses cancel keeps the full clear. */
+    slot.responses_live.valid = true;
+    j.req.api = API_OPENAI;
+    TEST_ASSERT(!responses_cancel_release_live_partial(&s, &slot, &j,
+                                                      "partial thinking", false));
+    TEST_ASSERT(!slot.responses_live.valid);
+
+    visible_live_free(&slot.thinking_live);
+    ds4_session_free_test_checkpoint(slot.session);
+    request_free(&j.req);
+}
