+    }
+    closedir(d);
+    kv_logf(kc, DS4_KVSTORE_LOG_KVCACHE,
+            "%s: kv cache sweep dir=%s mode=%s version=%u payload_abi=%u frame=%06x removed=%d would_remove=%d kept=%d freed=%llu bytes (%.2f GiB) (unreadable=%d bad-magic=%d version=%d payload-abi=%d frame=%d)",
