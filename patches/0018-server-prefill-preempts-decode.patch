+/* model_mu must be held.  Prompt processing pre-empts generation: one step of
+ * the executor is either a prefill chunk or a decode batch, never both, and a
+ * queued prefill owns the executor against every pending decode token.  A
+ * queued token touches no backend state — server_cancel_pending_decode_locked
+ * withdraws it — so it waits here while prompt work runs.
+ *
+ * Measured 2026-11-24, so nobody re-assumes a bound that is not there: decode
+ * does NOT get a slot between two chunks of the same prefill.  The window
+ * between server_prefill_leave and the next server_prefill_enter is shorter
+ * than the decode worker's wake-up, so the prefill re-queues first and the held
+ * generation waits for the whole prompt: a 23,395-token prefill (34.4 s) froze
+ * the peer's decode 39 s, and a 191,211-token rebuild (279.8 s) froze it 283 s.
+ * Bounding that needs a deliberate yield every N chunks, not a smaller chunk —
+ * a smaller chunk only lowers prefill throughput, because decode still cannot
+ * enter while any prefill is queued. */
+static bool server_decode_step_allowed_locked(const server *s) {
+    return !s->model_busy && server_next_prefill_slot_locked(s) < 0;
+}
+
+/* model_mu must be held.  The other half of the same ruling: a queued decode
+ * token never holds up prompt work.  Only the exclusive executor and the
+ * round-robin turn between prefills do, and an in-flight batch is exactly what
+ * model_busy claims. */
+static bool server_prefill_step_allowed_locked(const server *s, int id) {
+    return !s->model_busy && server_next_prefill_slot_locked(s) == id;
+}
