+            (unsigned)KV_CACHE_VERSION,
+            (unsigned)KV_CACHE_PAYLOAD_ABI, (unsigned)(kc->frame_id & 0xffffffu), removed, would, kept,
+            (unsigned long long)*freed,
+            (double)*freed / (1024.0 * 1024.0 * 1024.0),
+            n_short, n_magic, n_version, n_abi, n_frame);
+    return removed;
+}
