+/* The 2026-11-14 failure shape, as a regression:
+ *   - every request replays every image in history order (that is what
+ *     request_tokenize_multimodal_prompt does), so a hit refreshes recency in
+ *     that same order;
+ *   - the put loop evicts the least-recently-used entry to make room, which is
+ *     the next entry this same request is about to ask for;
+ *   - so a working set that does not fit the budget does not degrade by one
+ *     image per turn -- it loses every image on every turn.
+ * The old 128 MiB budget held 13 images of 1000 tokens, and the session that
+ * reported this had 15. Assert both halves: over-budget thrashes forever, a
+ * budget that fits the set stops encoding after round 1. */
+static void test_server_image_embedding_cache_thrash(void) {
+    const uint32_t dim = 2560;
+    const uint32_t tokens = 1000;               /* 10,240,000 bytes each */
+    const size_t images = 15;
+    const size_t entry_bytes = (size_t)tokens * dim * sizeof(float);
+    server_image_cache cache = {0};
+
+    /* Over budget: 14 images fit, 15 do not. */
+    const size_t tight = entry_bytes * 14;
+    size_t first_round_encodes = 0, steady_encodes = 0;
+    for (size_t round = 0; round < 3; round++) {
+        size_t encodes = 0;
+        for (size_t i = 0; i < images; i++) {
+            uint8_t fp[32] = {0};
+            fp[0] = (uint8_t)i;
+            fp[1] = (uint8_t)(i >> 8);
+            ds4_vision_embedding out = {0};
+            if (server_image_cache_get(&cache, fp, &out)) {
+                ds4_vision_embedding_free(&out);
+                continue;
+            }
+            encodes++;
+            float *data = malloc(entry_bytes);
+            TEST_ASSERT(data != NULL);
+            memset(data, 0, entry_bytes);
+            ds4_vision_embedding src = {.data = data, .token_count = tokens};
+            server_image_cache_put(&cache, fp, &src, dim, tight);
+        }
+        if (round == 0) first_round_encodes = encodes;
+        if (round == 2) steady_encodes = encodes;
+        TEST_ASSERT(cache.bytes <= tight);
+    }
+    TEST_ASSERT(first_round_encodes == images);
+    TEST_ASSERT(steady_encodes == images);   /* never recovers: the thrash is permanent */
+    server_image_cache_clear(&cache);
+
+    /* Budget that fits the same set: encode once, then nothing. */
+    const size_t roomy = entry_bytes * images;
+    size_t warm = 0, after = 0;
+    for (size_t round = 0; round < 3; round++) {
+        size_t encodes = 0;
+        for (size_t i = 0; i < images; i++) {
+            uint8_t fp[32] = {0};
+            fp[0] = (uint8_t)i;
+            fp[1] = (uint8_t)(i >> 8);
+            ds4_vision_embedding out = {0};
+            if (server_image_cache_get(&cache, fp, &out)) {
+                ds4_vision_embedding_free(&out);
+                continue;
+            }
+            encodes++;
+            float *data = malloc(entry_bytes);
+            TEST_ASSERT(data != NULL);
+            memset(data, 0, entry_bytes);
+            ds4_vision_embedding src = {.data = data, .token_count = tokens};
+            server_image_cache_put(&cache, fp, &src, dim, roomy);
+        }
+        if (round == 0) warm = encodes;
+        if (round == 2) after = encodes;
+    }
+    TEST_ASSERT(warm == images);
+    TEST_ASSERT(after == 0);
+    TEST_ASSERT(cache.bytes == roomy);
+    server_image_cache_clear(&cache);
+}
+
+static void test_vision_cache_mb_option(void) {
+    char *default_argv[] = {"ds4-server"};
+    server_config defaults = parse_options(1, default_argv);
+    TEST_ASSERT(defaults.vision_cache_mb == 1024);   /* literal: see below */
+
+    char *custom_argv[] = {"ds4-server", "--vision-cache-mb", "4096"};
+    server_config custom = parse_options(3, custom_argv);
+    TEST_ASSERT(custom.vision_cache_mb == 4096);
+
+    char *off_argv[] = {"ds4-server", "--vision-cache-mb", "0"};
+    server_config off = parse_options(3, off_argv);
+    TEST_ASSERT(off.vision_cache_mb == 0);
+
+    /* The literals above are deliberate: an assertion written against
+     * SERVER_IMAGE_CACHE_DEFAULT_MB stays green when the default is lowered
+     * back to the value that caused the 2026-11-14 thrash. This is that
+     * regression: the shipped default must hold the working set that failed,
+     * 15 images of 1000 tokens at 2560-wide fp32. */
+    const size_t set_bytes = 15 * 1000u * 2560u * sizeof(float);
+    TEST_ASSERT((size_t)defaults.vision_cache_mb * 1024u * 1024u >= set_bytes);
+    TEST_ASSERT(SERVER_IMAGE_CACHE_ENTRIES >= 15);
+
+    /* 0 must mean "do not cache", not "cache everything". */
+    server_image_cache cache = {0};
+    uint8_t fp[32] = {0};
+    fp[0] = 9;
+    float data[2] = {1.f, 2.f};
+    ds4_vision_embedding src = {.data = data, .token_count = 1};
+    server_image_cache_put(&cache, fp, &src, 2, 0);
+    TEST_ASSERT(cache.bytes == 0);
+}
