+static void sweep_log(void *ud, ds4_kvstore_log_type type, const char *msg) {
+    (void)ud;
+    (void)type;
+    size_t n = strlen(msg);
+    if (sweep_log_len + n + 2 < sizeof(sweep_log_buf)) {
+        memcpy(sweep_log_buf + sweep_log_len, msg, n);
+        sweep_log_len += n;
+        sweep_log_buf[sweep_log_len++] = '\n';
+        sweep_log_buf[sweep_log_len] = 0;
+    }
+}
+static void sweep_log_reset(void) {
+    sweep_log_buf[0] = 0;
+    sweep_log_len = 0;
+}
