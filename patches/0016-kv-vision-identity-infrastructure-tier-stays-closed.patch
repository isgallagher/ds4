+/* Identity of the images that condition the session's KV *right now*: the
+ * in-flight sync set while a sync is running (the checkpoint set is not yet
+ * rewritten), the checkpoint set otherwise.  A disk store must describe what
+ * the payload actually contains, and during a prefill progress callback the
+ * checkpoint set is the previous turn's. */
+size_t ds4_session_active_image_count(const ds4_session *s) {
+    if (!s) return 0;
+    if (s->sync_images) return s->sync_image_count;
+    return s->checkpoint_valid ? s->checkpoint_image_count : 0;
+}
+
+bool ds4_session_active_image_identity(const ds4_session *s, size_t i,
+                                       uint32_t *token_start,
+                                       uint32_t *token_count,
+                                       uint8_t fingerprint[32]) {
+    if (!s) return false;
+    if (s->sync_images) {
+        if (i >= s->sync_image_count) return false;
+        const ds4_vision_span *sp = &s->sync_images[i];
+        if (token_start) *token_start = sp->token_start;
+        if (token_count) *token_count = sp->embedding.token_count;
+        if (fingerprint)
+            memcpy(fingerprint, sp->embedding.fingerprint,
+                   sizeof(sp->embedding.fingerprint));
+        return true;
+    }
+    if (!s->checkpoint_valid || i >= s->checkpoint_image_count) return false;
+    if (token_start) *token_start = s->checkpoint_images[i].token_start;
+    if (token_count) *token_count = s->checkpoint_images[i].token_count;
+    if (fingerprint)
+        memcpy(fingerprint, s->checkpoint_images[i].fingerprint,
+               sizeof(s->checkpoint_images[i].fingerprint));
+    return true;
+}
+
+/* Adopt an externally authenticated image identity as the session's vision
+ * state, without touching the KV or the tokens.  Used when a disk checkpoint
+ * is restored: the payload carries image-conditioned rows whose pixels are
+ * named by the checkpoint file, not by the payload, and the next sync must be
+ * able to check them.  Never called while a sync is in flight. */
+void ds4_session_set_vision_identity(ds4_session *s,
+                                     const ds4_vision_span *images,
+                                     size_t image_count) {
+    if (!s || (image_count != 0 && !images)) return;
+    ds4_vision_identity *copy = NULL;
+    if (image_count != 0) {
+        if (image_count > SIZE_MAX / sizeof(copy[0])) return;
+        copy = calloc(image_count, sizeof(copy[0]));
+        if (!copy) return;
+        for (size_t i = 0; i < image_count; i++) {
+            copy[i].token_start = images[i].token_start;
+            copy[i].token_count = images[i].embedding.token_count;
+            memcpy(copy[i].fingerprint, images[i].embedding.fingerprint,
+                   sizeof(copy[i].fingerprint));
+        }
+    }
+    free(s->checkpoint_images);
+    s->checkpoint_images = copy;
+    s->checkpoint_image_count = image_count;
+}
