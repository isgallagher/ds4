+/* The provenance frame for this server's checkpoints.  KV rows are only
+ * meaningful under the rotary mapping that produced them, and the checkpoint
+ * header has no room for a YaRN factor, so the store carries a digest in those
+ * three free bytes: the inverse-frequency table the engine actually computed
+ * (which already covers the factor, the mscale and the native length), the
+ * model and routed-expert quantization it loaded, the context those rows were
+ * validated at, and the shape of the model file (its size plus the 24-byte GGUF
+ * preamble: version, tensor count, KV count).  Never the path and never the
+ * mtime, because moving a model file must not invalidate a store.  Owner ruling
+ * 2026-11-26, after a launcher bug wrote 83 GiB of native-frame rows into a
+ * directory labelled YaRN and no reader could tell the difference. */
+static uint32_t kv_cache_frame_id(ds4_engine *engine, const char *model_path,
+                                  int ctx_size) {
+    uint8_t rope[160];
+    const size_t rope_bytes = ds4_qwen4_rope_frame_bytes(rope, sizeof(rope));
+    if (!rope_bytes) return 0;
+    uint8_t buf[256];
+    size_t n = 0;
+    memcpy(buf + n, rope, rope_bytes); n += rope_bytes;
+    buf[n++] = (uint8_t)ds4_engine_model_id(engine);
+    buf[n++] = (uint8_t)ds4_engine_routed_quant_bits(engine);
+    const uint32_t ctx = (uint32_t)ctx_size;
+    for (int i = 0; i < 4; i++) buf[n++] = (uint8_t)((ctx >> (8 * i)) & 0xffu);
+    uint64_t size = 0;
+    struct stat st;
+    if (model_path && stat(model_path, &st) == 0) size = (uint64_t)st.st_size;
+    for (int i = 0; i < 8; i++) buf[n++] = (uint8_t)((size >> (8 * i)) & 0xffu);
+    uint8_t gguf[24] = {0};
