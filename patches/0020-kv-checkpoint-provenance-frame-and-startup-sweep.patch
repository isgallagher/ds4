+/* A checkpoint-shaped file the sweep can judge with no model: the fixed header
+ * plus a fixed body, written under an envelope the caller chooses.  The name is
+ * already the shape this store owns, so the only work left is the header. */
+static void write_envelope(const char *path, uint32_t version, uint8_t abi,
+                           uint32_t frame, size_t body) {
+    uint8_t h[DS4_KVSTORE_FIXED_HEADER];
+    ds4_kvstore_fill_header(h, 0, 4, DS4_KVSTORE_REASON_NEAR_TAIL, 0, 4096, 0, 32768,
+                            1000, 1000, body);
+    h[3] = (uint8_t)version;
+    h[20] = abi;
+    kv_header_set_frame(h, frame);
+    FILE *fp = fopen(path, "wb");
+    assert(fp);
+    assert(fwrite(h, 1, sizeof(h), fp) == sizeof(h));
+    for (size_t i = 0; i < body; i++) fputc((int)(i & 0xff), fp);
+    assert(!fclose(fp));
+}
+/* The sweep's own reporting is part of the acceptance, so the test reads the
+ * lines the operator would read. */
+static char sweep_log_buf[16384];
