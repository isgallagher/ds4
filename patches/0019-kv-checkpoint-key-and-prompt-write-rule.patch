+/* The disk checkpoint must be keyed by the rendering the client replays.
+ * A frontier that has both renderings prefers the reasoning rendering, because
+ * a client that receives reasoning summaries replays them inside the assistant
+ * turn; the answer rendering becomes the key only after a request actually
+ * continued from it.  Measured 2026-11-25: the answer rendering as the key cost
+ * 94,974 tokens on a restart, because the next request carried 2,070 bytes of
+ * reasoning the checkpoint did not hold. */
+static void test_visible_checkpoint_keys_disk_by_replayed_rendering(void) {
+    server s = {0};
+    pthread_mutex_init(&s.tool_mu, NULL);
+    const int tokens[] = {1, 2, 3, 4, 5};
+    server_slot slot = {0};
+    slot.session = ds4_session_new_test_checkpoint(tokens, 5);
+    slot.responses_live.valid = true;
+    slot.responses_live.live_tokens = 5;
+    slot.responses_live.visible_text = xstrdup("answer rendering");
+    slot.responses_live.visible_len = strlen("answer rendering");
+    slot.responses_live.visible_reasoning_text = xstrdup("reasoning rendering");
+    slot.responses_live.visible_reasoning_len = strlen("reasoning rendering");
+
+    uint8_t ext = 0;
+    const char *key = NULL;
+    char *picked = kv_cache_visible_checkpoint(&s, &slot, &ext, &key);
+    TEST_ASSERT(picked && strcmp(picked, "reasoning rendering") == 0);
+    TEST_ASSERT(ext == KV_EXT_RESPONSES_VISIBLE);
+    TEST_ASSERT(key && strcmp(key, "responses-visible-reasoning") == 0);
+    free(picked);
+
+    /* A request that continued from the answer rendering proves this client
+     * drops the summary, so the answer rendering is the key from then on. */
+    slot.responses_live.answer_only_disk_key = true;
+    picked = kv_cache_visible_checkpoint(&s, &slot, &ext, &key);
+    TEST_ASSERT(picked && strcmp(picked, "answer rendering") == 0);
+    TEST_ASSERT(key && strcmp(key, "responses-visible") == 0);
+    free(picked);
+
+    /* A turn that emitted no summary has one rendering, and it is the key. */
+    slot.responses_live.answer_only_disk_key = false;
+    free(slot.responses_live.visible_reasoning_text);
+    slot.responses_live.visible_reasoning_text = NULL;
+    slot.responses_live.visible_reasoning_len = 0;
+    picked = kv_cache_visible_checkpoint(&s, &slot, &ext, &key);
+    TEST_ASSERT(picked && strcmp(picked, "answer rendering") == 0);
+    TEST_ASSERT(key && strcmp(key, "responses-visible") == 0);
+    free(picked);
+
+    live_tool_state_free(&slot.responses_live);
+    ds4_session_free_test_checkpoint(slot.session);
+    pthread_mutex_destroy(&s.tool_mu);
+}
