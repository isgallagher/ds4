+ * for the request that wrote it. */
+static bool kv_cache_vision_verify_cb(void *ud, FILE *fp,
+                                      const ds4_kvstore_entry *hdr,
+                                      uint32_t text_bytes, const void *wanted) {
+    (void)ud;
