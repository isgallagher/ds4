+/* ------------------------------------------------------------------------
+ * Image identity in the checkpoint trailer.  A disk payload restores KV rows
+ * that were conditioned on image embeddings.  The token text names only the
+ * placeholder positions, so the same bytes can describe two different
+ * pictures: a checkpoint is reusable only by a request that can name the same
+ * pixels.  The identity therefore travels with the payload -- the ordered
+ * (token_start, row count, pixel fingerprint) of every image the session knew
+ * when the checkpoint was written, plus how many of them the stored frontier
+ * covers.
+ *
+ * The section is appended after the tool map and framed from the end of the
+ * file, so every existing checkpoint keeps its bytes and its tool map keeps
+ * its position.  No footer means no identity, which means "covers no image"
+ * and is loadable only by a request carrying no images.  The header bit is
+ * fail-closed: set without a readable footer rejects the load for everyone,
+ * because a checkpoint that claims image state it cannot name is exactly the
+ * wrong-attention case the gate exists for.
+ *
+ * A frontier that lands inside an image span is never stored: the payload
+ * would hold rows of an image the identity cannot describe as covered.
+ */
+#define KV_VISION_SECTION_MAGIC0 'K'
+#define KV_VISION_SECTION_MAGIC1 'V'
+#define KV_VISION_SECTION_MAGIC2 'I'
+#define KV_VISION_SECTION_MAGIC3 'S'
+#define KV_VISION_FOOTER_MAGIC0 'K'
+#define KV_VISION_FOOTER_MAGIC1 'V'
+#define KV_VISION_FOOTER_MAGIC2 'V'
+#define KV_VISION_FOOTER_MAGIC3 'S'
+#define KV_VISION_VERSION 1u
+#define KV_VISION_SECTION_HEADER 16u
+#define KV_VISION_RECORD 40u
+#define KV_VISION_FOOTER 16u
+/* Bound on a trailer a hostile or truncated file could ask us to walk.  A
+ * real request cannot exceed SERVER_MAX_IMAGES, which is far smaller. */
+#define KV_VISION_MAX_RECORDS 4096u
+
+typedef struct {
+    server *s;
+    const ds4_session *session;
+    /* Non-zero when this store describes image-conditioned KV rows and the
+     * identity below names them. */
+    bool vision;
+    int store_len;
+    size_t image_count;
+    size_t covered;
+} kv_store_ctx;
+
+typedef struct {
+    const ds4_vision_span *images;
+    size_t image_count;
+    /* Out: how many of the request's images the restored payload covers. */
+    size_t *covered_out;
+} kv_vision_verify;
+
+/* Decide whether this session's frontier can be described.  False means the
+ * caller must not write the checkpoint at all, which is today's behaviour. */
+static bool kv_vision_identity_prepare(const ds4_session *session, int store_len,
+                                       size_t *count_out, size_t *covered_out) {
+    if (count_out) *count_out = 0;
+    if (covered_out) *covered_out = 0;
+    if (!session || store_len <= 0) return false;
+    const size_t n = ds4_session_active_image_count(session);
+    uint64_t previous_end = 0;
+    size_t covered = 0;
+    for (size_t i = 0; i < n; i++) {
+        uint32_t start = 0, rows = 0;
+        uint8_t fp[32] = {0};
+        if (!ds4_session_active_image_identity(session, i, &start, &rows, fp))
+            return false;
+        const uint64_t end = (uint64_t)start + rows;
+        if (end > (uint64_t)store_len) {
+            /* Straddles the frontier: rows of this image are in the payload
+             * but the identity cannot call it covered, and a later render may
+             * place the frontier elsewhere.  Refuse the store. */
+            if (start < (uint64_t)store_len) return false;
+            break;
+        }
+        if (end < previous_end) return false;
+        previous_end = end;
+        covered++;
+    }
+    if (count_out) *count_out = n;
+    if (covered_out) *covered_out = covered;
+    return true;
+}
+
+static uint64_t kv_vision_section_bytes(const kv_store_ctx *ctx) {
+    if (!ctx || !ctx->vision || ctx->image_count == 0) return 0;
+    return KV_VISION_SECTION_HEADER +
+           (uint64_t)ctx->image_count * KV_VISION_RECORD + KV_VISION_FOOTER;
+}
+
+/* Written after the tool map, so the tool map keeps the position its loader
+ * reads from.  Streams the identity straight from the session; the caller
+ * holds inference_mu, so the spans cannot move underneath it. */
+static bool kv_vision_section_write(const kv_store_ctx *ctx, FILE *fp,
+                                    uint64_t *written) {
+    const uint64_t total = kv_vision_section_bytes(ctx);
+    if (written) *written = 0;
+    if (total == 0) return true;
+    uint8_t h[KV_VISION_SECTION_HEADER];
+    h[0] = KV_VISION_SECTION_MAGIC0;
+    h[1] = KV_VISION_SECTION_MAGIC1;
+    h[2] = KV_VISION_SECTION_MAGIC2;
+    h[3] = KV_VISION_SECTION_MAGIC3;
+    le_put32(h + 4, KV_VISION_VERSION);
+    le_put32(h + 8, (uint32_t)ctx->image_count);
+    le_put32(h + 12, (uint32_t)ctx->covered);
+    if (fwrite(h, 1, sizeof(h), fp) != sizeof(h)) return false;
+    for (size_t i = 0; i < ctx->image_count; i++) {
+        uint32_t start = 0, rows = 0;
+        uint8_t fp32[32] = {0};
+        uint8_t rec[KV_VISION_RECORD];
+        if (!ds4_session_active_image_identity(ctx->session, i, &start, &rows, fp32))
+            return false;
+        le_put32(rec, start);
+        le_put32(rec + 4, rows);
+        memcpy(rec + 8, fp32, sizeof(fp32));
+        if (fwrite(rec, 1, sizeof(rec), fp) != sizeof(rec)) return false;
+    }
+    uint8_t f[KV_VISION_FOOTER];
+    f[0] = KV_VISION_FOOTER_MAGIC0;
+    f[1] = KV_VISION_FOOTER_MAGIC1;
+    f[2] = KV_VISION_FOOTER_MAGIC2;
+    f[3] = KV_VISION_FOOTER_MAGIC3;
+    le_put32(f + 4, KV_VISION_VERSION);
+    le_put32(f + 8, (uint32_t)total);
+    f[12] = KV_VISION_SECTION_MAGIC0;
+    f[13] = KV_VISION_SECTION_MAGIC1;
+    f[14] = KV_VISION_SECTION_MAGIC2;
+    f[15] = KV_VISION_SECTION_MAGIC3;
+    if (fwrite(f, 1, sizeof(f), fp) != sizeof(f)) return false;
+    if (written) *written = total;
+    return true;
+}
+
+/* Read the identity back and check it against the request that wants the
+ * payload.  Streams, so a truncated file stops the walk.  Every field must
+ * match, positions included: the disk tier does not rebase, and a payload
+ * whose rows sit at different positions than the request's spans is a miss. */
+static bool kv_vision_section_verify(FILE *fp, uint64_t trailer_start,
+                                     uint64_t file_size,
+                                     const kv_vision_verify *want) {
+    if (!want) return false;
+    /* No room for a footer is no identity.  That is only loadable by a request
+     * with no images, and the caller decides that from the header bit; this
+     * function only ever answers "does the named identity match?". */
+    if (file_size < trailer_start + KV_VISION_FOOTER) return false;
+    uint8_t f[KV_VISION_FOOTER];
+    if (fseeko(fp, (off_t)(file_size - KV_VISION_FOOTER), SEEK_SET) != 0 ||
+        fread(f, 1, sizeof(f), fp) != sizeof(f)) return false;
+    const bool framed = f[0] == KV_VISION_FOOTER_MAGIC0 &&
+                        f[1] == KV_VISION_FOOTER_MAGIC1 &&
+                        f[2] == KV_VISION_FOOTER_MAGIC2 &&
+                        f[3] == KV_VISION_FOOTER_MAGIC3 &&
+                        le_get32(f + 4) == KV_VISION_VERSION &&
+                        f[12] == KV_VISION_SECTION_MAGIC0 &&
+                        f[13] == KV_VISION_SECTION_MAGIC1 &&
+                        f[14] == KV_VISION_SECTION_MAGIC2 &&
+                        f[15] == KV_VISION_SECTION_MAGIC3;
+    if (!framed) return false;
+    const uint32_t total = le_get32(f + 8);
+    if (total < KV_VISION_SECTION_HEADER + KV_VISION_FOOTER ||
+        total > (uint32_t)(file_size - trailer_start)) return false;
+    const uint64_t section_start = file_size - total;
+    uint8_t h[KV_VISION_SECTION_HEADER];
+    if (fseeko(fp, (off_t)section_start, SEEK_SET) != 0 ||
+        fread(h, 1, sizeof(h), fp) != sizeof(h)) return false;
+    if (h[0] != KV_VISION_SECTION_MAGIC0 || h[1] != KV_VISION_SECTION_MAGIC1 ||
+        h[2] != KV_VISION_SECTION_MAGIC2 || h[3] != KV_VISION_SECTION_MAGIC3 ||
+        le_get32(h + 4) != KV_VISION_VERSION) return false;
+    const uint32_t count = le_get32(h + 8);
+    const uint32_t covered = le_get32(h + 12);
+    if (count > KV_VISION_MAX_RECORDS ||
+        (uint64_t)KV_VISION_SECTION_HEADER + (uint64_t)count * KV_VISION_RECORD +
+            KV_VISION_FOOTER != (uint64_t)total)
+        return false;
+    if (count != want->image_count || covered > count) return false;
+    /* The frontier must cover EVERY image the request names.  The disk tier
+     * rebuilds the tail by tokenizing the text after the cached prefix, and
+     * image markers in that tail tokenize to a handful of tokens instead of
+     * the thousand placeholder rows the prompt really holds -- the effective
+     * prompt comes out short and the sync fails with "image span does not
+     * cover image placeholder tokens".  Measured 2026-11-14 19:28:13: a hit at
+     * 32,768 built ctx=32768..292451 for a 307,893-token prompt, the client got
+     * a 500, and the payload was discarded.  Serving a request that appends an
+     * image needs the live tier's splice helper in this path, which is stage 2;
+     * until then an uncovered image is a miss, which is the slow turn, not a
+     * broken one. */
+    if (covered != count) return false;
+    for (uint32_t i = 0; i < count; i++) {
+        uint8_t rec[KV_VISION_RECORD];
+        if (fread(rec, 1, sizeof(rec), fp) != sizeof(rec)) return false;
+        const ds4_vision_span *sp = &want->images[i];
+        if (le_get32(rec) != sp->token_start ||
+            le_get32(rec + 4) != sp->embedding.token_count ||
+            memcmp(rec + 8, sp->embedding.fingerprint, 32) != 0)
+            return false;
+    }
+    if (want->covered_out) *want->covered_out = covered;
+    return true;
+}
